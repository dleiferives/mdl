const byte = import("byte");
const io = import("io");
const parser = import("parser");
const tape = import("tape");

const RunResult = struct {
    left: List<Int32>,
    right: List<Int32>,
    past: List<Int32>,
    future: List<Int32>,
    input: List<Int32>,
    output: List<Int32>,
    remaining_fuel: Int32,
    dispatches: Int32,
    status: Int32,
    position: Int32,
};

pub fn run_text(
    source: String,
    input: List<Int32>,
    fuel: Int32,
    max_units: Int32,
    max_instructions: Int32,
    max_input: Int32,
    max_output: Int32,
) -> RunResult {
    var program: List<Int32> = List.empty();
    var parse_status: Int32 = 0;
    var parse_position: Int32 = 0;
    if (max_units < 0) {
        parse_status = 4;
    } else if (source.length() > max_units) {
        parse_status = 4;
    } else if (max_instructions < 0) {
        parse_status = 5;
    } else {
        program = parser.append_normalized(source, program);
        if (program.length() > max_instructions) {
            parse_status = 5;
            parse_position = max_instructions;
        } else {
            const validation: List<Int32> = parser.bracket_validation(program);
            parse_status = validation.last_or_zero();
            parse_position = validation.without_last().last_or_zero();
        }
    }
    return run_parsed(
        program,
        input,
        fuel,
        parse_status,
        parse_position,
        max_input,
        max_output,
    );
}

fn run_parsed(
    program: List<Int32>,
    input: List<Int32>,
    fuel: Int32,
    parse_status: Int32,
    parse_position: Int32,
    max_input: Int32,
    max_output: Int32,
) -> RunResult {
    var left: List<Int32> = tape.empty_left();
    var right: List<Int32> = tape.empty_right();
    var past: List<Int32> = List.empty();
    var future: List<Int32> = program;
    var remaining_input: List<Int32> = input;
    var output: List<Int32> = List.empty();
    var remaining_fuel: Int32 = fuel;
    var dispatches: Int32 = 0;
    var status: Int32 = parse_status;
    var position: Int32 = parse_position;

    if (status == 0) {
        if (fuel < 0) {
            status = 9;
        } else if (max_input < 0) {
            status = 7;
        } else if (input.length() > max_input) {
            status = 7;
        } else if (max_output < 0) {
            status = 6;
        }
    }
    if (status == 0) {
        var checked_input: List<Int32> = input;
        while (checked_input.length() > 0) {
            const input_byte: Int32 = checked_input.last_or_zero();
            if (input_byte < 0) {
                status = 8;
                break;
            } else if (input_byte > 255) {
                status = 8;
                break;
            }
            checked_input = checked_input.without_last();
        }
    }

    while (status == 0) {
        if (future.length() == 0) { break; }
        if (remaining_fuel <= 0) { break; }

        const operation: Int32 = future.last_or_zero();
        future = future.without_last();
        past = past.push(operation);
        remaining_fuel = remaining_fuel -% 1;
        dispatches = dispatches +% 1;

        if (operation == 62) {
            const old_left: List<Int32> = left;
            const old_right: List<Int32> = right;
            left = tape.right_left(old_left, old_right);
            right = tape.right_right(old_right);
        } else if (operation == 60) {
            const old_left: List<Int32> = left;
            const old_right: List<Int32> = right;
            left = tape.left_left(old_left);
            right = tape.left_right(old_left, old_right);
        } else if (operation == 43) {
            right = tape.set_current(right, byte.increment(tape.current(right)));
        } else if (operation == 45) {
            right = tape.set_current(right, byte.decrement(tape.current(right)));
        } else if (operation == 46) {
            if (output.length() >= max_output) {
                status = 6;
                position = past.length();
            } else {
                output = io.emit(output, tape.current(right));
            }
        } else if (operation == 44) {
            right = tape.set_current(right, io.read_or_zero(remaining_input));
            remaining_input = io.after_read(remaining_input);
        } else if (operation == 91) {
            if (tape.current(right) == 0) {
                var depth: Int32 = 0;
                while (future.length() > 0) {
                    const scanned: Int32 = future.last_or_zero();
                    future = future.without_last();
                    past = past.push(scanned);
                    if (scanned == 91) {
                        depth = depth +% 1;
                    } else if (scanned == 93) {
                        if (depth == 0) { break; }
                        depth = depth -% 1;
                    }
                }
            }
        } else if (operation == 93) {
            if (tape.current(right) != 0) {
                past = past.without_last();
                // Re-queue the closing bracket before the body. The backward scan
                // then pushes the body in reverse so its first opcode is the tail.
                future = future.push(93);
                var depth: Int32 = 0;
                while (past.length() > 0) {
                    const scanned: Int32 = past.last_or_zero();
                    past = past.without_last();
                    if (scanned == 93) {
                        depth = depth +% 1;
                        future = future.push(scanned);
                    } else if (scanned == 91) {
                        if (depth == 0) {
                            past = past.push(scanned);
                            break;
                        }
                        depth = depth -% 1;
                        future = future.push(scanned);
                    } else {
                        future = future.push(scanned);
                    }
                }
            }
        }
    }

    if (status == 0) {
        if (future.length() > 0) {
            status = 1;
            position = past.length();
        } else {
            position = past.length();
        }
    }

    return RunResult{
        .left = left,
        .right = right,
        .past = past,
        .future = future,
        .input = remaining_input,
        .output = output,
        .remaining_fuel = remaining_fuel,
        .dispatches = dispatches,
        .status = status,
        .position = position,
    };
}

fn checksum(result: RunResult) -> Int32 {
    var remaining: List<Int32> = result.output;
    var value: Int32 = result.status +% result.dispatches +% result.remaining_fuel;
    value = value +% tape.current(result.right);
    while (remaining.length() > 0) {
        value = value +% remaining.last_or_zero();
        remaining = remaining.without_last();
    }
    return value;
}

pub fn run_text_checksum(
    source: String,
    input: List<Int32>,
    fuel: Int32,
    max_units: Int32,
    max_instructions: Int32,
    max_input: Int32,
    max_output: Int32,
) -> Int32 {
    const result: RunResult = run_text(
        source,
        input,
        fuel,
        max_units,
        max_instructions,
        max_input,
        max_output,
    );
    return checksum(result);
}


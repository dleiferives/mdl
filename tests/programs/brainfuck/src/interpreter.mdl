const byte = import("byte");
const io = import("io");
const parser = import("parser");
const tape = import("tape");

const RunResult = struct {
    left: List<Int32>,
    right: List<Int32>,
    past: List<Int32>,
    future: List<Int32>,
    input: List<Int32>,
    output: List<Int32>,
    remaining_fuel: Int32,
    dispatches: Int32,
    status: Int32,
    position: Int32,
};

fn parse_text(
    source: String,
    max_units: Int32,
    max_instructions: Int32,
) -> { List<Int32>, Int32, Int32 } {
    var program := List.empty();
    var status := 0;
    var position := 0;
    if (max_units < 0) {
        status = 4;
    } else if (source.length() > max_units) {
        status = 4;
    } else if (max_instructions < 0) {
        status = 5;
    } else {
        program = parser.append_normalized(source, program);
        if (program.length() > max_instructions) {
            status = 5;
            position = max_instructions;
        } else {
            |status, position| <= parser.bracket_validation(program);
        }
    }
    return .{ program, status, position };
}

pub fn run_text(
    source: String,
    input: List<Int32>,
    fuel: Int32,
    max_units: Int32,
    max_instructions: Int32,
    max_input: Int32,
    max_output: Int32,
) -> RunResult {
    |const program, const status, const position| <= parse_text(
        source,
        max_units,
        max_instructions,
    );
    return run_parsed(
        program,
        input,
        fuel,
        status,
        position,
        max_input,
        max_output,
    );
}

fn input_status(
    input: List<Int32>,
    fuel: Int32,
    max_input: Int32,
    max_output: Int32,
) -> Int32 {
    if (fuel < 0) { return 9; }
    if (max_input < 0) { return 7; }
    if (input.length() > max_input) { return 7; }
    if (max_output < 0) { return 6; }

    var remaining := input;
    while (remaining.length() > 0) {
        const value := remaining.last_or_zero();
        if (value < 0) { return 8; }
        if (value > 255) { return 8; }
        remaining = remaining.without_last();
    }
    return 0;
}

fn skip_loop(
    past: List<Int32>,
    future: List<Int32>,
) -> { List<Int32>, List<Int32> } {
    var next_past := past;
    var next_future := future;
    var depth := 0;
    while (next_future.length() > 0) {
        const operation := next_future.last_or_zero();
        next_future = next_future.without_last();
        next_past = next_past.push(operation);
        if (operation == 91) {
            depth = depth +% 1;
        } else if (operation == 93) {
            if (depth == 0) { break; }
            depth = depth -% 1;
        }
    }
    return .{ next_past, next_future };
}

fn repeat_loop(
    past: List<Int32>,
    future: List<Int32>,
) -> { List<Int32>, List<Int32> } {
    var next_past := past.without_last();
    var next_future := future.push(93);
    var depth := 0;
    while (next_past.length() > 0) {
        const operation := next_past.last_or_zero();
        next_past = next_past.without_last();
        if (operation == 93) {
            depth = depth +% 1;
            next_future = next_future.push(operation);
        } else if (operation == 91) {
            if (depth == 0) {
                next_past = next_past.push(operation);
                break;
            }
            depth = depth -% 1;
            next_future = next_future.push(operation);
        } else {
            next_future = next_future.push(operation);
        }
    }
    return .{ next_past, next_future };
}

fn run_parsed(
    program: List<Int32>,
    input: List<Int32>,
    fuel: Int32,
    parse_status: Int32,
    parse_position: Int32,
    max_input: Int32,
    max_output: Int32,
) -> RunResult {
    var left := tape.empty_left();
    var right := tape.empty_right();
    var past := List.empty();
    var future := program;
    var remaining_input := input;
    var output := List.empty();
    var remaining_fuel := fuel;
    var dispatches := 0;
    var status := parse_status;
    var position := parse_position;

    if (status == 0) {
        status = input_status(input, fuel, max_input, max_output);
    }

    while (status == 0) {
        if (future.length() == 0) { break; }
        if (remaining_fuel <= 0) { break; }

        const operation := future.last_or_zero();
        future = future.without_last();
        past = past.push(operation);
        remaining_fuel = remaining_fuel -% 1;
        dispatches = dispatches +% 1;

        switch (operation) {
            62 => {
                |left, right| <= tape.move_right(left, right);
            },
            60 => {
                |left, right| <= tape.move_left(left, right);
            },
            43 => {
                right = tape.set_current(right, byte.increment(tape.current(right)));
            },
            45 => {
                right = tape.set_current(right, byte.decrement(tape.current(right)));
            },
            46 => {
                if (output.length() >= max_output) {
                    status = 6;
                    position = past.length();
                } else {
                    output = output.push(tape.current(right));
                }
            },
            44 => {
                |const value, remaining_input| <= io.read(remaining_input);
                right = tape.set_current(right, value);
            },
            91 => {
                if (tape.current(right) == 0) {
                    |past, future| <= skip_loop(past, future);
                }
            },
            93 => {
                if (tape.current(right) != 0) {
                    |past, future| <= repeat_loop(past, future);
                }
            },
            else => {},
        }
    }

    if (status == 0) {
        if (future.length() > 0) {
            status = 1;
        }
        position = past.length();
    }

    return RunResult{
        .left = left,
        .right = right,
        .past = past,
        .future = future,
        .input = remaining_input,
        .output = output,
        .remaining_fuel = remaining_fuel,
        .dispatches = dispatches,
        .status = status,
        .position = position,
    };
}

fn checksum(result: RunResult) -> Int32 {
    var remaining := result.output;
    var value := result.status +% result.dispatches +% result.remaining_fuel;
    value = value +% tape.current(result.right);
    while (remaining.length() > 0) {
        value = value +% remaining.last_or_zero();
        remaining = remaining.without_last();
    }
    return value;
}

pub fn run_text_checksum(
    source: String,
    input: List<Int32>,
    fuel: Int32,
    max_units: Int32,
    max_instructions: Int32,
    max_input: Int32,
    max_output: Int32,
) -> Int32 {
    return checksum(run_text(
        source,
        input,
        fuel,
        max_units,
        max_instructions,
        max_input,
        max_output,
    ));
}

pub fn run_book_showcase() {
    run.as(mc.entities(ArmorStand).with_tag("mdl_ps3_book").limit(1)) |reader| {
        var program := List.empty();
        var units := 0;
        var page_index := 99;
        while (page_index >= 0) {
            const page: String = reader.equipment.mainhand.components."minecraft:written_book_content".pages[page_index].raw;
            units = units +% page.length();
            program = parser.append_normalized(page, program);
            page_index = page_index -% 1;
        }

        var parse_status := 0;
        var parse_position := 0;
        if (units > 8192) {
            parse_status = 4;
        } else if (program.length() > 8192) {
            parse_status = 5;
            parse_position = 8192;
        } else {
            |parse_status, parse_position| <= parser.bracket_validation(program);
        }

        if (parse_status != 0) {
            reader.say("MDL_PS3_BRAINFUCK_PARSE_ERROR");
        } else if (program.length() == 0) {
            reader.say("MDL_PS3_BRAINFUCK_NO_PROGRAM");
        } else {
            const result := run_parsed(
                program,
                List.empty(),
                256,
                parse_status,
                parse_position,
                4096,
                4096,
            );
            if (result.status == 1) {
                reader.say("MDL_PS3_BRAINFUCK_FUEL_EXHAUSTED");
            } else if (result.status != 0) {
                reader.say("MDL_PS3_BRAINFUCK_RUNTIME_ERROR");
            } else if (result.output.length() != 1) {
                reader.say("MDL_PS3_BRAINFUCK_WRONG_OUTPUT");
            } else if (result.output.last_or_zero() == 65) {
                reader.say("MDL_PS3_BRAINFUCK_A");
            } else {
                reader.say("MDL_PS3_BRAINFUCK_WRONG_OUTPUT");
            }
        }
    }
}

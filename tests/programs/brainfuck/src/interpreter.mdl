        page = reader.equipment.mainhand.components."minecraft:written_book_content".pages[0].raw;
        units = units +% page.length();
        program = parser.append_normalized(page, program);
        var parse_status: Int32 = 0;
        var parse_position: Int32 = 0;
        if (units > 8192) {
            parse_status = 4;
        } else if (program.length() > 8192) {
            parse_status = 5;
            parse_position = 8192;
        } else {
            const validation: List<Int32> = parser.bracket_validation(program);
            parse_status = validation.last_or_zero();
            parse_position = validation.without_last().last_or_zero();
        }

        if (parse_status == 0) {
            if (program.length() == 0) {
                reader.say("MDL_PS3_BRAINFUCK_NO_PROGRAM");
            } else {
                const result: RunResult = run_parsed(
                    program,
                    List.empty(),
                    256,
                    parse_status,
                    parse_position,
                    4096,
                    4096,
                );
                if (result.status == 0) {
                    if (result.output.length() == 1) {
                        if (result.output.last_or_zero() == 65) {
                            reader.say("MDL_PS3_BRAINFUCK_A");
                        } else {
                            reader.say("MDL_PS3_BRAINFUCK_WRONG_OUTPUT");
                        }
                    } else {
                        reader.say("MDL_PS3_BRAINFUCK_WRONG_OUTPUT");
                    }
                } else if (result.status == 1) {
                    reader.say("MDL_PS3_BRAINFUCK_FUEL_EXHAUSTED");
                } else {
                    reader.say("MDL_PS3_BRAINFUCK_RUNTIME_ERROR");
                }
            }
        } else {
            reader.say("MDL_PS3_BRAINFUCK_PARSE_ERROR");
        }
    }
}

const opcode = import("opcode");

pub fn append_normalized(source: String, initial: List<Int32>) -> List<Int32> {
    var remaining := source;
    var program := initial;
    while (remaining.length() > 0) {
        const decoded := opcode.decode_tail(remaining);
        if (decoded != 0) {
            program = program.push(decoded);
        }
        remaining = remaining.without_last_unit();
    }
    return program;
}

// Status 0 is valid, 2 is unmatched `[`, and 3 is unmatched `]`.
pub fn bracket_validation(program: List<Int32>) -> { Int32, Int32 } {
    var remaining := program;
    var opens := List.empty();
    var position := 0;
    var status := 0;
    var error_position := 0;
    while (remaining.length() > 0) {
        const current := remaining.last_or_zero();
        remaining = remaining.without_last();
        if (opcode.is_open(current)) {
            opens = opens.push(position);
        } else if (opcode.is_close(current)) {
            if (opens.length() == 0) {
                status = 3;
                error_position = position;
                break;
            }
            opens = opens.without_last();
        }
        position = position +% 1;
    }
    if (status == 0) {
        if (opens.length() > 0) {
            status = 2;
            error_position = opens.last_or_zero();
        }
    }
    return .{ status, error_position };
}

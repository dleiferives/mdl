pub fn empty_left() -> List<Int32> {
    return List.empty();
}

pub fn empty_right() -> List<Int32> {
    return List.empty().push(0);
}

pub fn current(right: List<Int32>) -> Int32 {
    return right.last_or_zero();
}

pub fn set_current(right: List<Int32>, value: Int32) -> List<Int32> {
    return right.without_last().push(value);
}

pub fn move_right(
    left: List<Int32>,
    right: List<Int32>,
) -> { List<Int32>, List<Int32> } {
    var next_right := right.without_last();
    if (next_right.length() == 0) {
        next_right = next_right.push(0);
    }
    return .{ left.push(current(right)), next_right };
}

pub fn move_left(
    left: List<Int32>,
    right: List<Int32>,
) -> { List<Int32>, List<Int32> } {
    return .{ left.without_last(), right.push(left.last_or_zero()) };
}
